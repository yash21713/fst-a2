generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleType {
  ADMIN
  MEMBER
  GUEST
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  TRANSFER
  PAYMENT
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum EmailStatus {
  SENT
  DELIVERED
  BOUNCED
  COMPLAINED
  OPENED
  CLICKED
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

model Role {
  id          String   @id @default(uuid())
  name        RoleType @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]

  @@map("roles")
}

model User {
  id         String     @id @default(uuid())
  email      String     @unique
  name       String
  avatarUrl  String?
  roleId     String
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  status     UserStatus @default(ACTIVE)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  sessions     Session[]
  transactions Transaction[]
  auditLogs    AuditLog[]
  emailLogs    EmailLog[]

  @@index([roleId])
  @@index([email])
  @@map("users")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  userAgent    String?
  ipAddress    String?
  createdAt    DateTime @default(now())

  @@index([userId])
  @@map("sessions")
}

model Transaction {
  id             String            @id @default(uuid())
  reference      String            @unique
  amount         Decimal           @db.Decimal(12, 2)
  currency       String            @default("USD")
  type           TransactionType   @default(TRANSFER)
  status         TransactionStatus @default(COMPLETED)
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  recipientEmail String
  recipientName  String?
  description    String?
  metadata       Json?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([userId])
  @@index([reference])
  @@index([createdAt])
  @@map("transactions")
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  entity    String
  entityId  String?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  ipAddress String?
  userAgent String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([createdAt])
  @@map("audit_logs")
}

model EmailLog {
  id            String      @id @default(uuid())
  resendEmailId String?     @unique
  toEmail       String
  templateName  String
  subject       String
  status        EmailStatus @default(SENT)
  userId        String?
  user          User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  payload       Json?
  errorMessage  String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([userId])
  @@index([resendEmailId])
  @@index([status])
  @@index([createdAt])
  @@map("email_logs")
}
